{
    "version": 2,
    "builds": [
      { 
        "src": "api/**/*.js",
        "use": "@vercel/node"
      },
      {
        "src": "public/**",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/test",
        "dest": "/api/test.js"
      },
      {
        "src": "/submit-data",
        "dest": "/api/submit-data.js"
      },
      {
        "src": "/(.*)",
        "dest": "/public/$1"
      }
    ]
  }
  